FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache openssl
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --chown=appuser:appgroup apps/ceo1983_app_fe/.output ./apps/ceo1983_app_fe/.output
COPY --chown=appuser:appgroup apps/ceo1983_app_fe/docker-entrypoint.sh ./apps/ceo1983_app_fe/

RUN chmod +x ./apps/ceo1983_app_fe/docker-entrypoint.sh || true
USER appuser

EXPOSE 8080
WORKDIR /app/apps/ceo1983_app_fe

ENV NODE_OPTIONS="--max-old-space-size=768"
ENV VITE_APP_SCOPE=crm_platform
ENV VITE_APP_NAME="CEO 1983 CRM Admin"
ENV VITE_APP_DEFAULT_ROUTE=/association

CMD ["sh", "-c", "if [ -f docker-entrypoint.sh ]; then ./docker-entrypoint.sh; else node .output/server/index.mjs; fi"]
