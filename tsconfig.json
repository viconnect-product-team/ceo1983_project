{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./apps/ceo1983_app_fe/src/*"],
      "@vibe/db": ["./packages/db/index.ts"],
      "@vibe/db/*": ["./packages/db/*"],
      "@vibe/shared": ["./packages/shared/index.ts"],
      "@vibe/shared/*": ["./packages/shared/*"]
    }
  },
  "include": ["apps/ceo1983_app_fe/src/**/*"],
  "exclude": [
    "apps/ceo1983_app_fe/src/__tests__",
    "apps/ceo1983_app_fe/src/__tests__/**/*",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "node_modules",
    "dist",
    ".output"
  ]
}
